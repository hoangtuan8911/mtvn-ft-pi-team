<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mtvn.ftpi.autosync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_DIR_PLACEHOLDER/tools/mac-auto-sync/mtvn-pull.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPO_DIR_PLACEHOLDER</string>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME_PLACEHOLDER/Library/Logs/MTVN_FT_PI/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_PLACEHOLDER/Library/Logs/MTVN_FT_PI/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MTVN_REPO_DIR</key>
    <string>REPO_DIR_PLACEHOLDER</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
